{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgileNet",
  "version": "0.1.0",
  "identifier": "ai.icen.agilenet",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "windows": [
      {
        "title": "AgileNet 客户端",
        "width": 1024,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/256x256.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
