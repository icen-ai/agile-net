{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "anet-gui",
  "version": "0.1.0",
  "identifier": "ai.icen.agilenet",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AgileNet 客户端",
        "width": 1024,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; frame-src http://127.0.0.1:*",
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": "zh-CN"
      }
    },
    "android": {
      "minSdkVersion": 26
    },
    "fileAssociations": [
      {
        "ext": ["anet"],
        "name": "AgileNet 凭据文件",
        "description": "AgileNet 接入/扇出凭据（.anet 信封，可 PIN 加密）",
        "role": "Viewer",
        "mimeType": "application/json"
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["anet", "agilenet"]
      },
      "mobile": [
        { "scheme": ["anet"], "host": "connect" },
        { "scheme": ["anet"], "host": "fanout" },
        { "scheme": ["agilenet"], "host": "connect" },
        { "scheme": ["agilenet"], "host": "fanout" }
      ]
    }
  }
}
