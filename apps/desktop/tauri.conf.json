{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "anet-gui",
  "version": "0.1.0",
  "identifier": "ai.icen.agilenet",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AgileNet 客户端",
        "width": 1024,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; frame-src http://127.0.0.1:*",
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
